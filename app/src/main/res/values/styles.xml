<resources>
<style name="QuietTheme" parent="android:style/Theme.Material.NoActionBar">
<item name="android:fontFamily">sans-serif</item><item name="android:colorAccent">#91B7FF</item>
<item name="android:textColorPrimary">#EFF4FF</item><item name="android:textColorSecondary">#ADBCD4</item>
<item name="android:windowLightStatusBar">false</item>
<item name="android:alertDialogTheme">@style/QuietDialog</item></style>
<style name="QuietDialog" parent="android:style/Theme.Material.Dialog.Alert">
<item name="android:windowBackground">@drawable/dialog_panel_blue</item><item name="android:colorAccent">#91B7FF</item>
<item name="android:textColorPrimary">#EFF4FF</item><item name="android:textColorSecondary">#ADBCD4</item>
<item name="android:buttonBarButtonStyle">@style/QuietDialogButton</item></style>
<style name="QuietDialogButton" parent="android:style/Widget.Material.Button.Borderless">
<item name="android:background">@drawable/dialog_button_blue</item><item name="android:textColor">#EFF4FF</item>
<item name="android:textAllCaps">false</item><item name="android:paddingLeft">20dp</item><item name="android:paddingRight">20dp</item></style>
<style name="QuietGreenTheme" parent="android:style/Theme.Material.NoActionBar">
<item name="android:fontFamily">sans-serif</item><item name="android:colorAccent">#83D6A3</item>
<item name="android:textColorPrimary">#EFF7F1</item><item name="android:textColorSecondary">#ADBDB2</item>
<item name="android:windowLightStatusBar">false</item>
<item name="android:alertDialogTheme">@style/QuietGreenDialog</item></style>
<style name="QuietGreenDialog" parent="android:style/Theme.Material.Dialog.Alert">
<item name="android:windowBackground">@drawable/dialog_panel_green</item><item name="android:colorAccent">#83D6A3</item>
<item name="android:textColorPrimary">#EFF7F1</item><item name="android:textColorSecondary">#ADBDB2</item>
<item name="android:buttonBarButtonStyle">@style/QuietGreenDialogButton</item></style>
<style name="QuietGreenDialogButton" parent="android:style/Widget.Material.Button.Borderless">
<item name="android:background">@drawable/dialog_button_green</item><item name="android:textColor">#EFF7F1</item>
<item name="android:textAllCaps">false</item><item name="android:paddingLeft">20dp</item><item name="android:paddingRight">20dp</item></style>
<style name="QuietLightTheme" parent="android:style/Theme.Material.Light.NoActionBar">
<item name="android:fontFamily">sans-serif</item><item name="android:colorAccent">#315EC4</item>
<item name="android:textColorPrimary">#17213B</item><item name="android:textColorSecondary">#52627A</item>
<item name="android:windowLightStatusBar">true</item>
<item name="android:alertDialogTheme">@style/QuietLightDialog</item></style>
<style name="QuietLightDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
<item name="android:windowBackground">@drawable/dialog_panel_light</item><item name="android:colorAccent">#315EC4</item>
<item name="android:textColorPrimary">#17213B</item><item name="android:textColorSecondary">#52627A</item>
<item name="android:buttonBarButtonStyle">@style/QuietLightDialogButton</item></style>
<style name="QuietLightDialogButton" parent="android:style/Widget.Material.Button.Borderless">
<item name="android:background">@drawable/dialog_button_light</item><item name="android:textColor">#17213B</item>
<item name="android:textAllCaps">false</item><item name="android:paddingLeft">20dp</item><item name="android:paddingRight">20dp</item></style>
<style name="QuietWarmTheme" parent="android:style/Theme.Material.NoActionBar">
<item name="android:fontFamily">sans-serif</item><item name="android:colorAccent">#D9B17C</item>
<item name="android:textColorPrimary">#F7F1E9</item><item name="android:textColorSecondary">#C5B6A4</item>
<item name="android:windowLightStatusBar">false</item>
<item name="android:alertDialogTheme">@style/QuietWarmDialog</item></style>
<style name="QuietWarmDialog" parent="android:style/Theme.Material.Dialog.Alert">
<item name="android:windowBackground">@drawable/dialog_panel_warm</item><item name="android:colorAccent">#D9B17C</item>
<item name="android:textColorPrimary">#F7F1E9</item><item name="android:textColorSecondary">#C5B6A4</item>
<item name="android:buttonBarButtonStyle">@style/QuietWarmDialogButton</item></style>
<style name="QuietWarmDialogButton" parent="android:style/Widget.Material.Button.Borderless">
<item name="android:background">@drawable/dialog_button_warm</item><item name="android:textColor">#F7F1E9</item>
<item name="android:textAllCaps">false</item><item name="android:paddingLeft">20dp</item><item name="android:paddingRight">20dp</item></style>
<style name="DrawerAnimation"><item name="android:windowEnterAnimation">@anim/drawer_enter</item><item name="android:windowExitAnimation">@anim/drawer_exit</item></style></resources>