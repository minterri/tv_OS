<resources>
    <style name="QuietTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#77CC96</item>
        <item name="android:colorControlHighlight">#446EBE8C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/QuietDialog</item>
    </style>
    <style name="QuietDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_panel</item>
        <item name="android:colorAccent">#77CC96</item>
        <item name="android:textColorPrimary">#EDF3EE</item>
        <item name="android:textColorSecondary">#A8B0AA</item>
        <item name="android:buttonBarButtonStyle">@style/QuietDialogButton</item>
    </style>
    <style name="QuietDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/dialog_button</item>
        <item name="android:textColor">#EDF3EE</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>
    <style name="DrawerAnimation">
        <item name="android:windowEnterAnimation">@anim/drawer_enter</item>
        <item name="android:windowExitAnimation">@anim/drawer_exit</item>
    </style>
</resources>
